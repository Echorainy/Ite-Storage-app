# Copy to .env.local. Never put a provider key in EXPO_PUBLIC_*.
OPENAI_API_KEY=
# To test from a phone on trusted Wi-Fi set SPEECH_HOST=0.0.0.0.
SPEECH_HOST=127.0.0.1
SPEECH_PORT=3001
SPEECH_WEB_ORIGIN=http://localhost:8081
# On a phone replace localhost with your computer's LAN address.
EXPO_PUBLIC_SPEECH_API_URL=http://localhost:3001/speech-to-text
